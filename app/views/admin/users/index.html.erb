<h2>ユーザー一覧</h2>

<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Email</th>
            <th>登録日</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        <% @users.each do |user| %>
            <tr>
                <td><%= user.id %></td>
                <td><%= user.email %></td>
                <td><%= user.created_at.strftime("%Y-%m-%d") %></td>
                <td><%= link_to "詳細", admin_user_path(user) %></td>
            </tr>
        <% end %>
    </tbody>
</table>